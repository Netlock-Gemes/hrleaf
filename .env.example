# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=hrleaf

# The admin account (sees every note, manages users and sharing).
# Members are created from the admin area, not here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs session cookies (32+ random chars). Changing it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
