# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
MONGODB_DB=hrleaf

# The admin account (sees every note, manages users and sharing).
# Members are created from the admin area, not here.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Signs session cookies (32+ random chars). Changing it signs everyone out.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# Optional: turns on the MCP endpoint (/api/mcp) so Claude Code can write and edit notes.
# 32+ random chars; it can open every note. Leave empty to keep the endpoint off (404).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MCP_TOKEN=
# Optional: second MCP address /api/mcp/<MCP_URL_SECRET> for claude.ai connectors and
# the Claude mobile apps (they can't send a token header). 32+ random chars, not the same
# as MCP_TOKEN. Anyone with the address can write notes. Leave empty to keep it off.
MCP_URL_SECRET=
# Name shown as "edited by" for notes written through MCP (default: claude)
MCP_AUTHOR=
